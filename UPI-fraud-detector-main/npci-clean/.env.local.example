# ─── Required ───────────────────────────────────────────
# Get from https://console.groq.com (free)
GROQ_API_KEY=gsk_...

# ─── Optional – Rate Limiting ────────────────────────────
# Get from https://upstash.com (free tier: 10k req/day)
# If these are NOT set, rate limiting is disabled (ok for local dev)
UPSTASH_REDIS_REST_URL=https://YOUR_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
