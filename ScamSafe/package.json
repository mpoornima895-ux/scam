{
  "name": "scamsafe",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc -p tsconfig.test.json",
    "test:unit": "npm run build:test && node --test test/unit/trust.test.js test/unit/redaction.test.js test/unit/parse.test.js test/unit/storage.test.js test/unit/cloud.test.js test/unit/rules.test.js test/unit/consent.test.js backend/analyze.test.js",
    "bench": "npm run build:test && node run_benchmark_200.js",
    "holdout": "npm run build:test && node scripts/run_holdout.js",
    "test": "npm run test:unit && node run_benchmark_200.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.21",
    "expo-modules-core": "~57.0.15",
    "react": "19.2.0",
    "react-native": "0.86.0",
    "sms-reader": "file:./modules/sms-reader"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  }
}
